<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- .NET 10 LTS (supported through Nov 2028). NOT net8.0 — .NET 8 and 9
         both reach end of support on 2026-11-10.
         The windows10.0.19041.0 platform version is what projects
         Windows.Media.Control (SMTC) into C# with no interop layer. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Required for zero-allocation DSP: raw spans and pointer arithmetic in
         the FFT and ring buffer hot paths. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Workstation concurrent GC. Server GC would reserve per-core heaps and
         balloon the working set well past the 60 MB budget. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>

    <AssemblyName>Ripple</AssemblyName>
    <RootNamespace>Ripple</RootNamespace>
    <!-- The icon lands in Phase 5. Conditioned so a missing file is not a build error. -->
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)\..\..\assets\ripple.ico')">..\..\assets\ripple.ico</ApplicationIcon>

    <!-- DO NOT enable PublishAot. CsWinRT projection + AOT trimming is a known
         source of obscure runtime failures, and trimmed self-contained R2R
         already lands comfortably inside the footprint budget. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- FALSE, and this is load-bearing. With native libraries bundled into the single file
         they are self-extracted to a temp directory at startup, and Silk.NET's own native
         resolver does not find glfw3.dll there: the published exe dies with
         "PlatformNotSupportedException: Couldn't find a suitable window platform
         (GlfwPlatform - not applicable)" while the identical build run from bin/ works, because
         bin/ has glfw3.dll sitting beside it. Explicitly registering the platform does not
         help — registration succeeds and the platform then reports itself not applicable,
         which is the native load failing one layer down.

         Leaving natives loose costs a handful of files next to the exe and matches what
         shaders/, presets/ and data/ already do. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin whatever `dotnet add package` resolves, then record the resolved
         versions in README.md. Do not trust the version numbers below. -->
    <PackageReference Include="Silk.NET.Windowing" Version="*" />
    <PackageReference Include="Silk.NET.OpenGL" Version="*" />
    <PackageReference Include="Silk.NET.Input" Version="*" />
    <!-- Silk.NET.Windowing has no blocking event wait (DoEvents is glfwPollEvents).
         The idle path needs glfwWaitEventsTimeout so a hidden window BLOCKS instead
         of polling; see GlHost.WaitForEvents and plan 11. -->
    <PackageReference Include="Silk.NET.GLFW" Version="*" />
    <PackageReference Include="NAudio" Version="*" />

    <!-- The now-playing caption (§8.5) rasterizes text to a bitmap with GDI+ and uploads
         it as a texture. The alternative was a hand-built bitmap font atlas, which is more
         code for a worse result: §8.5 asks specifically for a legible face at small sizes,
         and a real system font hinted at 15 px is exactly that. Windows-only, which this
         project already is. -->
    <PackageReference Include="System.Drawing.Common" Version="*" />

    <!-- Optional convenience wrapper over SMTC. Try the raw
         Windows.Media.Control API first; add this only if the async
         session-event plumbing proves fiddly.
    <PackageReference Include="Dubya.WindowsMediaController" Version="*" />
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- The std140 round-trip test links a probe program through
         ShaderProgram.Link, which is internal because nothing outside the
         renderer should be building programs. Widening it to public for the
         test's sake would be the wrong trade. -->
    <InternalsVisibleTo Include="Ripple.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shaders, presets, and data are loaded from disk at runtime so they can
         hot-reload via FileSystemWatcher. Copy on build, do not embed. -->
    <Content Include="..\..\shaders\**\*" LinkBase="shaders" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\presets\**\*.json" LinkBase="presets" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\**\*.json" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
